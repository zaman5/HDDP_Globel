PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin page key (required to view applications, enquiries and CVs, and to publish jobs).
# Use a long random value, at least 24 characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it the admin API stays locked.
ADMIN_TOKEN=

# Public site address used in the live sitemap (no trailing slash)
SITE_URL=https://hddpconsultants.com
